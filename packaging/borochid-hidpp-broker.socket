# The HID++ broker's socket. Anyone may connect; the broker itself decides
# per connection (SO_PEERCRED: root or the active seat0 session's user), and
# even then only passes the HID++ calls its allowlist permits.
[Unit]
Description=Borochid HID++ broker socket

[Socket]
ListenStream=/run/borochid-hidpp/broker.sock
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
